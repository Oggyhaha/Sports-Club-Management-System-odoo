# Backend Environment Configuration Example
# Copy this file to backend/.env and update the values for your environment.

PROJECT_NAME="Champions Club API"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/champions_club"

# Secret key for JWT sessions and password hashing
SECRET_KEY="replace-with-a-secure-random-secret-key"
